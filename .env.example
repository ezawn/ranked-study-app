# ---------------------------------------------------------------------------
# StudyQuest environment
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required
# to boot the app — everything else has a working local fallback.
# ---------------------------------------------------------------------------

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyquest?schema=public"

# Used by the Vitest integration suite (must be a DIFFERENT database — it gets wiped)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyquest_test?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google sign-in. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# AI provider
# Leave AI_PROVIDER=mock to run the whole app with no API key: PDF-to-quiz,
# written-answer marking and test feedback all work using a deterministic
# local provider. Switch to "anthropic" and add a key for real AI.
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"            # mock | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# File storage
# "local" writes to ./storage (git-ignored). "s3" uses any S3-compatible bucket.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"        # local | s3
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Email — only needed for password reset.
# Leave RESEND_API_KEY blank and reset links are printed to the server console
# instead of sent, so the flow works in development with no provider at all.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="StudyQuest <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Background jobs — /api/cron/* endpoints require this bearer token.
# The worker (npm run worker) reads it too.
# ---------------------------------------------------------------------------
CRON_SECRET="change-me-in-production"
