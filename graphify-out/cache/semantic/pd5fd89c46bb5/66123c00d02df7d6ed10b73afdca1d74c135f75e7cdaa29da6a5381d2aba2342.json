{"nodes": [{"id": "src_lib_coins_rules", "label": "coins/rules.ts (single source of economy numbers)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every number in the Study Coin economy lives here so the economy can be changed without touching feature code."}, {"id": "src_server_services_coins_awardcoins", "label": "awardCoins()", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only function in the codebase that changes a coin balance; there is no other 'increment: coins' anywhere."}, {"id": "readme_anticheat_rationale", "label": "Why the Coin Economy Can't Be Farmed", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten enumerated safeguards (single mutator, idempotent ledger, one transaction, measured not reported time, server-issued deadlines, server-side marking, override doesn't pay, verified completion, DB-read limits, timezone-change caps) ensure nothing trusts the browser."}, {"id": "readme_ledger_pattern", "label": "Append-Only Ledger with Idempotency Key", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A double-submit violates a unique index and awards nothing; User.coinBalance is a cache of SUM(ledger.amount) reconciled by a worker."}, {"id": "readme_heartbeat_mechanism", "label": "Server-Measured Heartbeat Time", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elapsed time is min(now - storedLastHeartbeat, 45s) computed on the server's clock; replaying the request credits zero and disappearing for an hour credits only one interval."}, {"id": "readme_srs_algorithm", "label": "Adaptive Spaced Repetition Intervals", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_struggle_detector", "label": "The Struggle Detector", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three failures in the last four reviews floors the interval at 12 hours; it deliberately never fires on a correct answer, because pinning a recovering card to 12h would stop it ever escaping."}, {"id": "readme_cram_mode", "label": "Cram Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cram reviews are recorded but never touch Smart Mode scheduling, so cramming before a test can't wreck a carefully built long-term schedule."}, {"id": "src_lib_coins_rank_getrankmultiplier", "label": "getRankMultiplier()", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 1.0 today; every award already multiplies by it so future rank-based multipliers are a change to one function."}, {"id": "readme_layering_rule", "label": "The Layering Rule (pages -> actions -> services)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages and components never touch the database; server actions validate and rate-limit, services own business rules and transactions, and pure logic has no I/O so it can be tested exhaustively."}, {"id": "src_app_app_layout_requireuser", "label": "requireUser() authorisation boundary", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called before any child page renders in the (app) layout, so no feature page has to remember to check; every service query is additionally scoped by ownership or membership."}, {"id": "readme_storage_driver", "label": "Storage Driver (local disk / S3 stub)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The local driver writes to disk, which an ephemeral container will lose; the S3 adapter must be finished before production."}, {"id": "src_lib_rate_limit_hit", "label": "hit() in-process rate limiter", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process and fine for one Node process, but defence in depth either way since coin rules are idempotent and time-clamped."}, {"id": "readme_mcq_deterministic_decision", "label": "Decision: MCQ Marked Deterministically, Not by AI", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple choice is exact-match, so AI marking would be slower, cost money, and could only make it worse."}], "edges": [{"source": "src_lib_coins_rules", "target": "src_server_services_coins_awardcoins", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "src_server_services_coins_awardcoins", "target": "readme_ledger_pattern", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight