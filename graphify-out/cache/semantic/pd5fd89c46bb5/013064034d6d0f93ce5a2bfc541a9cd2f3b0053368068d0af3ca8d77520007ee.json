{"nodes": [{"id": "product_purpose", "label": "Product Purpose: Measurable Progression", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "StudyQuest turns revision into measurable progression; success is a student choosing to open it on a day nobody told them to revise."}, {"id": "product_study_coins", "label": "Study Coins (earned currency)", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coins come from finishing sets, quiz scores, the daily quiz and verified study time; a competitor can copy points and badges but not a progression system validated server-side against measured activity."}, {"id": "product_smart_mode_srs", "label": "Smart Mode (Spaced Repetition Scheduler)", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "product_arena_placeholder", "label": "Arena Placeholder Routes", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The six Arena routes are deliberate non-functional placeholders that must stay visible but must not claim to work, per the user's request that the Arena remain a quiet door rather than a headline."}, {"id": "product_principles", "label": "Product Principles", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earned-not-awarded, next-action-beats-summary, solo-revision-is-the-product, honest-about-what-is-not-built, and the student's-day-not-the-server's \u2014 five commitments the product must not violate."}, {"id": "product_daily_quiz", "label": "Daily Quiz", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attempting it, not passing it, is what extends the streak."}, {"id": "product_communities", "label": "Communities", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Communities exist to move material between students, not to become a feed to scroll."}, {"id": "product_plans", "label": "Free / Premium Plans", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "product_hard_constraints", "label": "Hard Constraints (server-validated rewards)", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every reward calculation is validated server-side and study time is measured between server heartbeats; the frontend must never be trusted to decide whether a student has earned coins."}], "edges": [{"source": "product_purpose", "target": "product_study_coins", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_study_coins", "target": "product_daily_quiz", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_smart_mode_srs", "target": "product_purpose", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_arena_placeholder", "targe